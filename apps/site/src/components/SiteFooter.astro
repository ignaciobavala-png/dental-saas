---
import { footer, product } from '../data/product';
import Container from './Container.astro';
import Logo from './Logo.astro';
---

<footer class="border-t border-line bg-canvas">
  <Container>
    <div class="grid gap-10 py-14 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-[34ch] text-sm text-muted">{footer.legal}</p>
      </div>

      {footer.columns.map((column) => (
        <div>
          <p class="text-xs font-semibold text-ink">{column.title}</p>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-muted hover:text-ink">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col gap-3 border-t border-line py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {product.name}. Todos los derechos reservados.</p>
      <p>Hecho en Buenos Aires.</p>
    </div>
  </Container>
</footer>
