---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'md' | 'sm';
  class?: string;
  rel?: string;
  target?: string;
}
const { href, variant = 'primary', size = 'md', class: cls = '', rel, target } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg font-semibold transition-colors active:translate-y-px';
const sizes = size === 'sm' ? 'h-9 px-3.5 text-sm' : 'h-10 px-5 text-sm';
const variants = {
  primary: 'bg-accent text-white hover:bg-accent-hover',
  outline: 'border border-line bg-canvas text-ink hover:bg-soft',
  ghost: 'text-body hover:bg-soft hover:text-ink',
};
---

<a href={href} rel={rel} target={target} class={`${base} ${sizes} ${variants[variant]} ${cls}`}>
  <slot />
</a>
