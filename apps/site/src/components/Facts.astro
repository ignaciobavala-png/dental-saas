---
import { facts } from '../data/product';
import Container from './Container.astro';
---

<section class="bg-dark py-14 text-white">
  <Container>
    <dl class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {facts.map((fact) => (
        <div>
          <dt class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{fact.value}</dt>
          <dd class="mt-1 text-sm text-on-dark-soft">{fact.label}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
