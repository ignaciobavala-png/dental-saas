---
import { CalendarX, NotebookPen, PhoneOff } from 'lucide-astro';
import { pains } from '../data/product';
import Container from './Container.astro';

const icons = [PhoneOff, CalendarX, NotebookPen];
---

<section class="py-20 sm:py-24">
  <Container>
    <h2 class="max-w-[26ch] text-3xl font-bold tracking-tight sm:text-4xl">
      Lo que se pierde cuando la clínica no está ordenada
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {pains.map((pain, i) => {
        const Icon = icons[i];
        return (
          <div class="reveal rounded-xl bg-card p-6">
            <Icon size={22} class="text-ink" />
            <h3 class="mt-4 text-base font-semibold">{pain.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body">{pain.text}</p>
          </div>
        );
      })}
    </div>
  </Container>
</section>
