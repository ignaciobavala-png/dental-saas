---
import { testimonials } from '../data/product';
import Container from './Container.astro';

function initials(name: string): string {
  return name
    .replace(/^(Dra?\.|Dr\.)\s*/i, '')
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}
---

<section class="py-20 sm:py-24">
  <Container>
    <h2 class="max-w-[24ch] text-3xl font-bold tracking-tight sm:text-4xl">
      Consultorios que ya trabajan distinto
    </h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="reveal flex flex-col rounded-xl bg-card p-6">
          <blockquote class="text-sm leading-relaxed text-body">"{t.quote}"</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-canvas text-xs font-semibold text-ink" aria-hidden>
              {initials(t.name)}
            </span>
            <div class="leading-tight">
              <p class="text-sm font-semibold">{t.name}</p>
              <p class="text-xs text-muted">{t.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </Container>
</section>
