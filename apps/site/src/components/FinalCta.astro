---
import { finalCta } from '../data/product';
import Container from './Container.astro';
import SignupForm from './SignupForm.astro';
---

<section id="empezar" class="border-t border-line pb-24 pt-20 sm:pt-24">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{finalCta.title}</h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-base text-body">{finalCta.text}</p>
      <SignupForm />
    </div>
  </Container>
</section>
