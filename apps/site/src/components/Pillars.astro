---
import { Check } from 'lucide-astro';
import { pillars } from '../data/product';
import Container from './Container.astro';
---

<section id="producto" class="border-t border-line bg-soft py-20 sm:py-24">
  <Container>
    <h2 class="max-w-[24ch] text-3xl font-bold tracking-tight sm:text-4xl">
      Tres cosas que hoy pagás por separado
    </h2>
    <p class="mt-3 max-w-[60ch] text-base text-body">
      Una agencia para la web, una secretaria y un software de gestión. Acá son la misma plataforma, con una sola cuenta.
    </p>

    <div class="mt-14 space-y-16 sm:space-y-24">
      {pillars.map((pillar) => (
        <div class="reveal grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
          <div class={pillar.flip ? 'lg:order-2' : ''}>
            <span class="inline-flex items-center gap-2 rounded-full border border-line bg-canvas px-3 py-1 text-xs font-medium text-body">
              <span class="size-1.5 rounded-full bg-accent" />
              {pillar.tag}
            </span>
            <h3 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">{pillar.title}</h3>
            <p class="mt-3 max-w-[52ch] text-base leading-relaxed text-body">{pillar.text}</p>
            <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2">
              {pillar.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-body">
                  <Check size={16} class="mt-0.5 shrink-0 text-ink" />
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <div class={pillar.flip ? 'lg:order-1' : ''}>
            <div class="overflow-hidden rounded-xl border border-line bg-canvas shadow-[0_1px_2px_rgba(16,16,16,0.04)]">
              <img
                src={pillar.image.src}
                alt={pillar.image.alt}
                width="1200"
                height="900"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
