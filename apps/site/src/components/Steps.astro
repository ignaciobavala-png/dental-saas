---
import { Settings2, Sparkles, Upload } from 'lucide-astro';
import { steps } from '../data/product';
import Container from './Container.astro';

const icons = [Settings2, Upload, Sparkles];
---

<section class="border-t border-line py-20 sm:py-24">
  <Container>
    <h2 class="max-w-[22ch] text-3xl font-bold tracking-tight sm:text-4xl">De cero a funcionando en una tarde</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {steps.map((step, i) => {
        const Icon = icons[i];
        return (
          <div class="reveal">
            <span class="grid size-10 place-items-center rounded-lg border border-line bg-soft text-ink">
              <Icon size={18} />
            </span>
            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body">{step.text}</p>
          </div>
        );
      })}
    </div>
  </Container>
</section>
