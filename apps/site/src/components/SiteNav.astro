---
import { nav, product } from '../data/product';
import Container from './Container.astro';
import Button from './Button.astro';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/80 backdrop-blur">
  <Container class="flex h-16 items-center gap-6">
    <Logo />
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Secciones">
      {nav.map((item) => (
        <a href={item.href} class="rounded-lg px-3 py-2 text-sm font-medium text-muted hover:bg-soft hover:text-ink">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a href={product.appUrl} class="hidden rounded-lg px-3 py-2 text-sm font-medium text-body hover:bg-soft hover:text-ink sm:inline-flex">
        Ingresar
      </a>
      <Button href="#empezar" size="sm">Empezá ahora</Button>

      <details class="relative lg:hidden">
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-line text-ink" aria-label="Abrir menú">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </summary>
        <div class="absolute right-0 top-11 w-52 rounded-xl border border-line bg-canvas p-1.5 shadow-[0_4px_12px_rgba(16,16,16,0.08)]">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-body hover:bg-soft hover:text-ink">
              {item.label}
            </a>
          ))}
          <a href={product.appUrl} class="block rounded-lg px-3 py-2 text-sm font-medium text-body hover:bg-soft hover:text-ink">
            Ingresar
          </a>
        </div>
      </details>
    </div>
  </Container>
</header>
