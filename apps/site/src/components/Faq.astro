---
import { faqs } from '../data/product';
import Container from './Container.astro';
---

<section id="preguntas" class="py-20 sm:py-24">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <h2 class="max-w-[16ch] text-3xl font-bold tracking-tight sm:text-4xl">
        Preguntas que nos hacen siempre
      </h2>

      <div class="divide-y divide-line border-t border-line">
        {faqs.map((faq) => (
          <details name="faq" class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <span class="text-base font-medium text-ink">{faq.q}</span>
              <svg
                class="size-4 shrink-0 text-muted transition-transform group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-2.5 max-w-[62ch] text-sm leading-relaxed text-body">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
