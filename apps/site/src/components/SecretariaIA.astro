---
import { Bot, Check } from 'lucide-astro';
import { secretaria } from '../data/product';
import Container from './Container.astro';
---

<section id="secretaria" class="py-20 sm:py-24">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-14">
      <div class="reveal">
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-soft px-3 py-1 text-xs font-medium text-body">
          <span class="size-1.5 rounded-full bg-success" />
          {secretaria.tag}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{secretaria.title}</h2>
        <p class="mt-3 max-w-[50ch] text-base leading-relaxed text-body">{secretaria.text}</p>
        <ul class="mt-6 space-y-2.5">
          {secretaria.bullets.map((bullet) => (
            <li class="flex items-start gap-2 text-sm text-body">
              <Check size={16} class="mt-0.5 shrink-0 text-ink" />
              {bullet}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal">
        <div class="overflow-hidden rounded-xl border border-line bg-canvas shadow-[0_4px_12px_rgba(16,16,16,0.06)]">
          <div class="flex items-center gap-2.5 border-b border-line px-4 py-3">
            <span class="grid size-8 place-items-center rounded-lg bg-card text-ink">
              <Bot size={16} />
            </span>
            <div class="leading-tight">
              <p class="text-sm font-semibold">Secretaría IA</p>
              <p class="text-xs text-muted">Responde en segundos</p>
            </div>
            <span class="ml-auto inline-flex items-center gap-1.5 text-xs text-muted">
              <span class="size-1.5 rounded-full bg-success" />
              En línea
            </span>
          </div>

          <div class="space-y-3 bg-soft/60 p-4">
            {secretaria.chat.map((msg) => {
              if (msg.from === 'slots') {
                return (
                  <div class="flex flex-wrap gap-2 pl-2">
                    {['Jueves 16:30', 'Viernes 09:00', 'Lunes 11:15'].map((slot) => (
                      <span class="rounded-full border border-line bg-canvas px-3 py-1.5 text-xs font-medium text-ink">{slot}</span>
                    ))}
                  </div>
                );
              }
              if (msg.from === 'patient') {
                return (
                  <div class="flex justify-end">
                    <p class="max-w-[80%] rounded-2xl rounded-br-md bg-accent px-3.5 py-2 text-sm text-white">
                      {msg.text}
                    </p>
                  </div>
                );
              }
              return (
                <div class="flex justify-start">
                  <p class="max-w-[85%] rounded-2xl rounded-bl-md border border-line bg-canvas px-3.5 py-2 text-sm text-ink">
                    {msg.text}
                  </p>
                </div>
              );
            })}
          </div>

          <div class="border-t border-line px-4 py-3">
            <p class="text-xs text-muted">La IA nunca accede a la ficha clínica del paciente.</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
