import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Pains from '../components/Pains.astro';
import Pillars from '../components/Pillars.astro';
import SecretariaIA from '../components/SecretariaIA.astro';
import Steps from '../components/Steps.astro';
import Facts from '../components/Facts.astro';
