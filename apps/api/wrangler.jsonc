{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-saas",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
