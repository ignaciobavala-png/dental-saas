{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-saas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/src/db/migrations"
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AI_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
