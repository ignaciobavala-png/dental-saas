# URL pública de la API (Worker de Hono). En local, el wrangler dev usa el 8787.
PUBLIC_API_URL=http://localhost:8787
# Slug del consultorio que muestra esta landing. Se usa para pedir el contenido
# público a `GET /api/public/clinic/:slug`. Todavía es manual (esta app no
# resuelve el tenant por hostname; ver H4 en docs/01-arquitectura.md) y tiene
# que ser el slug real de una clínica creada vía /api/auth/signup.
#
# Si queda vacío o la API no responde, la landing usa el fixture local
# (src/data/clinic.ts) para que el build no se rompa.
PUBLIC_CLINIC_SLUG=consultorio-demo
