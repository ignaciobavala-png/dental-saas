# URL pública de la API (Worker de Hono). En local, el wrangler dev usa el 8787.
PUBLIC_API_URL=http://localhost:8787
# Slug del consultorio cuya secretaría IA se muestra en esta landing. Hoy es
# manual (esta app todavía no resuelve el tenant por hostname, ver H4 en
# docs/01-arquitectura.md); tiene que ser el slug real de una clínica creada
# vía /api/auth/signup.
PUBLIC_CLINIC_SLUG=consultorio-demo
