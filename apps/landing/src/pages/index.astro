---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Obras from '../components/Obras.astro';
import Tratamientos from '../components/Tratamientos.astro';
import Equipo from '../components/Equipo.astro';
import Secretaria from '../components/Secretaria.astro';
import Galeria from '../components/Galeria.astro';
import Opiniones from '../components/Opiniones.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Odontología Arocena | Dentista en Caballito, CABA"
  description="Consultorio odontológico en Caballito. Turnos online, obras sociales y tratamientos de odontología general, ortodoncia, implantes y estética dental."
>
  <Nav />
  <main>
    <Hero />
    <Obras />
    <Tratamientos />
    <Equipo />
    <Secretaria />
    <Galeria />
    <Opiniones />
    <Ubicacion />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
