---
import { env } from 'cloudflare:workers';

// La raíz no es una página: cada consultorio vive en /c/:slug. Quien entra
// sin slug es alguien del consultorio, así que va directo al login del panel.
const panel = (env.PANEL_URL ?? 'http://127.0.0.1:8787').replace(/\/$/, '');
return Astro.redirect(`${panel}/login`, 302);
