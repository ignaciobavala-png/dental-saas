---
import { clinic } from '../data/clinic';
const [first, ...rest] = clinic.testimonials;
---
<section class="bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
    <figure class="reveal">
      <blockquote class="font-display text-2xl leading-snug font-medium tracking-tight text-ink md:text-3xl">
        “{first.quote}”
      </blockquote>
      <figcaption class="mt-5 text-sm text-muted">
        <span class="font-medium text-ink">{first.name}</span> · {first.detail}
      </figcaption>
    </figure>

    <div class="flex flex-col justify-end gap-8">
      {rest.map((t) => (
        <figure class="reveal border-t border-line pt-6">
          <blockquote class="leading-relaxed text-ink">“{t.quote}”</blockquote>
          <figcaption class="mt-3 text-sm text-muted">
            <span class="font-medium text-ink">{t.name}</span> · {t.detail}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
