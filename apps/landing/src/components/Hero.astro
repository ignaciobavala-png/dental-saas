---
const clinic = Astro.locals.clinic;
---
<section id="inicio" class="clinic-hero">
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-location">{clinic.tagline || clinic.name}</p>
      <h1>Cuidar tu sonrisa<br /><span>empieza por acá.</span></h1>
      <p class="hero-description">Conocé tratamientos, horarios y opciones de atención. La recepción virtual te ayuda a dejar una solicitud de turno.</p>
      <div class="hero-actions">
        <a href="#chat-secretaria" data-chat-cta class="clinic-button">Pedir un turno <span aria-hidden="true">↗</span></a>
        <a href="#tratamientos" class="clinic-link">Ver tratamientos <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="/images/asistente-dental.webp" alt="Avatar ilustrado de nuestra asistente virtual, con una sonrisa de bienvenida" width="800" height="1000" fetchpriority="high" />
      <figcaption>
        <span class="portrait-greeting">Hola, ¿en qué te ayudo?</span>
        <span>Recepción virtual para consultas y solicitudes</span>
        <a href="#chat-secretaria" data-chat-cta aria-label="Escribir a la asistente virtual">↗</a>
      </figcaption>
    </figure>
  </div>
</section>
