---
import { clinic } from '../data/clinic';
---
<section id="reservar" class="scroll-mt-20 bg-accent text-bone">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-5 py-16 md:flex-row md:items-center md:justify-between md:px-8 md:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-bone md:text-4xl">
        Reservá tu turno hoy
      </h2>
      <p class="mt-4 leading-relaxed text-bone/75">
        Elegís el día y el horario que te quede cómodo. Te confirmamos al instante.
      </p>
    </div>
    <div class="flex flex-col items-start gap-3">
      <a
        href={clinic.whatsapp}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-bone px-6 py-3.5 text-sm font-medium text-accent transition-transform hover:-translate-y-0.5 active:translate-y-px"
      >
        Reservar turno
      </a>
      <p class="text-sm text-bone/70">
        o llamanos al <a href={clinic.phoneHref} class="underline underline-offset-2 hover:text-bone">{clinic.phone}</a>
      </p>
    </div>
  </div>
</section>
