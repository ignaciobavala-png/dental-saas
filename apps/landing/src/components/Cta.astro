---
const clinic = Astro.locals.clinic;
---
<section id="reservar" class="scroll-mt-20 bg-accent-soft text-ink">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-5 py-16 md:flex-row md:items-center md:justify-between md:px-8 md:py-24">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Dejá tu solicitud de turno
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        Consultá disponibilidad y compartí tus datos para que el consultorio pueda confirmar tu visita.
      </p>
    </div>
    <div class="flex flex-col items-start gap-3">
      <a
        href={clinic.whatsapp || '#chat-secretaria'}
        target={clinic.whatsapp ? '_blank' : undefined}
        rel={clinic.whatsapp ? 'noopener' : undefined}
        class="clinic-button"
      >
        Solicitar un turno
      </a>
      {clinic.phone && <p class="text-sm text-muted">o llamanos al <a href={clinic.phoneHref} class="underline underline-offset-2 hover:text-ink">{clinic.phone}</a></p>}
    </div>
  </div>
</section>
