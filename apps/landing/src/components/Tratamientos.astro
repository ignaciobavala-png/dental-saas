---
const clinic = Astro.locals.clinic;
---
<section id="tratamientos" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
          Tratamientos del consultorio
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          Elegí una orientación y consultá disponibilidad con la recepción virtual. El equipo revisa cada solicitud antes de confirmar.
        </p>
      </div>
      <a href="#chat-secretaria" data-chat-cta class="clinic-link inline-flex min-h-11 items-center gap-2">
        Consultar ahora <span aria-hidden="true">→</span>
      </a>
    </div>

    {clinic.treatments.length > 0 && (
    <ul class="reveal mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {clinic.treatments.map((t) => (
        <li class="group relative flex min-h-[18rem] flex-col overflow-hidden rounded-[1.25rem] border border-line bg-surface p-5 shadow-[0_16px_40px_rgba(23,63,55,0.06)] transition duration-200 hover:-translate-y-0.5 hover:border-accent-soft hover:shadow-[0_22px_52px_rgba(23,63,55,0.12)]">
          <div>
            <h3 class="font-display text-2xl font-semibold leading-tight text-ink">{t.name}</h3>
            <p class="mt-3 max-w-[34rem] text-sm leading-relaxed text-muted">
              {t.detail || 'Consultá si este tratamiento es adecuado para tu caso y qué horarios tiene disponibles el consultorio.'}
            </p>
          </div>

          <div class="mt-auto flex flex-col gap-5 pt-6">
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex min-h-9 items-center rounded-full bg-accent-soft px-3 text-sm font-semibold text-accent">
                {t.duration}
              </span>
              <span class="inline-flex min-h-9 items-center rounded-full bg-bone px-3 text-sm font-semibold text-ink ring-1 ring-line">
                {t.price}
              </span>
            </div>
            <a
              href="#chat-secretaria"
              data-chat-cta
              class="inline-flex min-h-11 items-center justify-between gap-3 rounded-full bg-ink px-4 text-sm font-semibold text-white transition-colors hover:bg-accent"
            >
              Ver disponibilidad <span aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    )}
  </div>
</section>
