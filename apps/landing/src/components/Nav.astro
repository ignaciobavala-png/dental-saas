---
import { clinic } from '../data/clinic';
const links = [
  { href: '#tratamientos', label: 'Tratamientos' },
  { href: '#equipo', label: 'Profesionales' },
  { href: '#consultorio', label: 'Consultorio' },
  { href: '#ubicacion', label: 'Ubicación' },
];
---
<header class="sticky top-0 z-40 border-b border-line bg-bone/95 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 md:px-8">
    <a href="#inicio" class="flex items-baseline gap-2">
      <span class="font-display text-xl font-semibold tracking-tight text-ink">{clinic.name}</span>
      <span class="hidden text-xs text-muted sm:inline">Caballito, CABA</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm text-muted md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="transition-colors hover:text-ink">{l.label}</a></li>
      ))}
    </ul>

    <a
      href="#reservar"
      class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-bone transition-colors hover:bg-accent-hover active:translate-y-px"
    >
      Reservar turno
    </a>
  </nav>
</header>
