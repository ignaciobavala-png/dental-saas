---
const clinic = Astro.locals.clinic;
const links = [
  { href: '#tratamientos', label: 'Tratamientos' },
  ...(clinic.team.length ? [{ href: '#equipo', label: 'Profesionales' }] : []),
  { href: '#ubicacion', label: 'Ubicación' },
];
---
<header class="sticky top-0 z-40 border-b border-line bg-bone/95 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 md:px-8">
    <a href="#inicio" class="flex min-w-0 items-baseline gap-2">
      <span class="truncate font-display text-base font-semibold tracking-tight text-ink sm:text-lg">{clinic.name}</span>

    </a>

    <ul class="hidden items-center gap-8 text-sm text-muted lg:flex">
      {links.map((l) => (
        <li><a href={l.href} class="transition-colors hover:text-ink">{l.label}</a></li>
      ))}
    </ul>

    <a
      href="#chat-secretaria"
      data-chat-cta
      class="clinic-button shrink-0"
    >
      Pedir un turno
    </a>
  </nav>
</header>
