---
const steps = [
  {
    n: '01',
    title: 'Escribí tu consulta',
    detail: 'Contanos qué necesitás desde el chat o por WhatsApp. Si es urgente, te orientamos enseguida.',
  },
  {
    n: '02',
    title: 'Elegí día y horario',
    detail: 'La secretaría virtual te muestra los horarios libres de cada profesional y cuánto dura el tratamiento.',
  },
  {
    n: '03',
    title: 'Queda confirmado',
    detail: 'El turno se agenda solo y te lo confirmamos al instante. No hace falta que llames.',
  },
];
---
<section id="como-pedir-turno" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Pedir turno es así de simple
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        Sin formularios eternos ni esperar a que atiendan el teléfono.
      </p>
    </div>

    <ol class="reveal mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6">
      {steps.map((s) => (
        <li class="border-t border-line pt-6">
          <span class="font-display text-sm font-semibold tracking-wide text-accent">{s.n}</span>
          <h3 class="mt-3 font-display text-xl font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{s.detail}</p>
        </li>
      ))}
    </ol>

    <a href="#chat-secretaria" class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline">
      Probar la secretaría ahora <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
