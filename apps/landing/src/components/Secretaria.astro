---
import { getClinicData } from '../lib/clinic';
const clinic = await getClinicData();
---
<section class="bg-accent text-bone">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-2 lg:gap-16">
    <div class="reveal max-w-lg">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-bone md:text-4xl">
        Una secretaría que contesta a cualquier hora
      </h2>
      <p class="mt-4 leading-relaxed text-bone/75">
        Escribís desde la web o por WhatsApp, te muestra los horarios libres y deja el turno confirmado. También saca
        dudas sobre obras sociales, precios y urgencias, sin que nadie tenga que atender el teléfono.
      </p>
      <a
        href="#chat-secretaria"
        data-chat-cta
        class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-bone hover:underline"
      >
        Probar la secretaría <span aria-hidden="true">→</span>
      </a>
    </div>

    <div id="chat-secretaria" class="reveal w-full max-w-md scroll-mt-24 lg:justify-self-end">
      <div class="overflow-hidden rounded-2xl bg-bone text-ink shadow-[0_24px_60px_-30px_rgba(0,0,0,0.5)]">
        <div class="flex items-center justify-between border-b border-line px-5 py-3">
          <p class="text-sm font-medium">{clinic.name}</p>
          <span class="inline-flex items-center gap-1.5 text-xs text-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>en línea
          </span>
        </div>

        <div
          data-chat-messages
          aria-live="polite"
          class="flex max-h-[22rem] min-h-[16rem] flex-col gap-3 overflow-y-auto px-5 py-5 text-sm"
        >
          <p class="w-fit max-w-[90%] rounded-2xl rounded-bl-md bg-surface px-4 py-2.5 text-ink ring-1 ring-line">
            ¡Hola! Soy la secretaria virtual de {clinic.name}. Puedo darte turnos, precios y obras sociales. ¿En qué
            te ayudo?
          </p>
        </div>

        <form data-chat-form class="flex items-center gap-2 border-t border-line px-4 py-3">
          <label for="chat-input" class="sr-only">Escribí tu consulta</label>
          <input
            id="chat-input"
            data-chat-input
            type="text"
            name="message"
            autocomplete="off"
            placeholder="Escribí tu consulta…"
            class="h-10 w-full rounded-lg border border-line bg-surface px-3 text-sm text-ink outline-none placeholder:text-muted focus:border-accent"
          />
          <button
            type="submit"
            data-chat-send
            class="h-10 shrink-0 rounded-lg bg-accent px-4 text-sm font-medium text-bone transition-colors hover:bg-accent-hover disabled:opacity-50"
          >
            Enviar
          </button>
        </form>

        <p data-chat-error class="hidden px-5 pb-3 text-xs text-red-600"></p>
      </div>
      <p class="mt-3 text-center text-xs text-bone/60">
        Probá: “¿Atienden OSDE?”, “Quiero un turno para una limpieza” o “¿Cuánto sale un blanqueamiento?”.
      </p>
    </div>
  </div>
</section>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787';
  const CLINIC_SLUG = import.meta.env.PUBLIC_CLINIC_SLUG ?? '';

  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = document.querySelector<HTMLInputElement>('[data-chat-input]');
  const messagesEl = document.querySelector<HTMLElement>('[data-chat-messages]');
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-chat-send]');
  const errorEl = document.querySelector<HTMLElement>('[data-chat-error]');

  const BUBBLE = 'w-fit max-w-[90%] whitespace-pre-wrap rounded-2xl px-4 py-2.5';
  const USER_BUBBLE = `${BUBBLE} ml-auto rounded-br-md bg-accent text-bone`;
  const BOT_BUBBLE = `${BUBBLE} rounded-bl-md bg-surface text-ink ring-1 ring-line`;

  const history: ChatMessage[] = [];

  function addBubble(role: 'user' | 'assistant', text: string): HTMLParagraphElement {
    const bubble = document.createElement('p');
    bubble.className = role === 'user' ? USER_BUBBLE : BOT_BUBBLE;
    bubble.textContent = text;
    messagesEl?.append(bubble);
    messagesEl?.scrollTo({ top: messagesEl.scrollHeight, behavior: 'smooth' });
    return bubble;
  }

  function showError(message: string | null) {
    if (!errorEl) return;
    errorEl.textContent = message ?? '';
    errorEl.classList.toggle('hidden', !message);
  }

  async function send(text: string) {
    if (!messagesEl || !sendBtn) return;

    history.push({ role: 'user', content: text });
    addBubble('user', text);
    showError(null);

    if (input) input.value = '';
    sendBtn.disabled = true;

    const bubble = addBubble('assistant', 'escribiendo…');
    let answer = '';

    if (!CLINIC_SLUG) {
      messagesEl.removeChild(bubble);
      showError('Falta configurar PUBLIC_CLINIC_SLUG (ver .env.example) para saber a qué consultorio responder.');
      sendBtn.disabled = false;
      return;
    }

    try {
      const url = new URL(`${API_URL}/api/secretaria/chat`);
      url.searchParams.set('clinic', CLINIC_SLUG);
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok || !res.body) {
        const detail = await res.json().catch(() => null);
        throw new Error(detail?.error ?? `El servidor respondió ${res.status}.`);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();

      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        answer += decoder.decode(value, { stream: true });
        bubble.textContent = answer;
        messagesEl.scrollTo({ top: messagesEl.scrollHeight });
      }

      if (!answer.trim()) {
        bubble.textContent = 'No pude responder eso. ¿Me lo repetís o te paso el WhatsApp del consultorio?';
        return;
      }

      history.push({ role: 'assistant', content: answer });
    } catch (error) {
      bubble.remove();
      showError(
        error instanceof Error
          ? `${error.message} (¿está corriendo la API en ${API_URL}?)`
          : 'No pude conectarme con la secretaría.',
      );
      sendBtn.disabled = false;
    } finally {
      sendBtn.disabled = false;
      input?.focus();
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input?.value.trim();
    if (text) void send(text);
  });

  document.querySelector('[data-chat-cta]')?.addEventListener('click', () => {
    setTimeout(() => input?.focus(), 300);
  });
</script>
