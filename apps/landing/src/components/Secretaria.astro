---
const clinic = Astro.locals.clinic;
const starters = ['Quiero pedir un turno', '¿Qué horarios tienen?', '¿Con qué coberturas trabajan?'];
---
<section class="chat-section" id="consultas">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:px-8 md:py-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="reveal max-w-lg">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">Un primer paso,<br />una duda menos.</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">Estamos para ayudarte a organizar tu visita. Consultá horarios, tratamientos o dejá una solicitud de turno desde acá.</p>
      <p class="mt-5 text-sm leading-relaxed text-muted">Te responde la recepción virtual del consultorio. Si preferís hablar con el equipo, {clinic.whatsapp ? <a href={clinic.whatsapp} target="_blank" rel="noopener" class="font-semibold text-accent underline underline-offset-4">escribinos por WhatsApp</a> : 'podés usar los datos de contacto del consultorio'}.</p>
    </div>
    <div id="chat-secretaria" data-clinic-slug={clinic.slug} class="reveal w-full scroll-mt-24">
      <div class="chat-card">
        <div class="flex items-center gap-3 border-b border-line bg-surface px-5 py-4">
          <img class="chat-avatar" src="/images/asistente-dental.webp" width="52" height="52" alt="" loading="lazy" />
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-ink">{clinic.name}</p>
            <p data-chat-status role="status" class="mt-0.5 text-xs text-muted">Recepción virtual · Consultas y solicitudes</p>
          </div>
        </div>
        <div data-chat-messages role="log" aria-label="Conversación con la asistente" aria-live="polite" class="flex max-h-[22rem] min-h-[13rem] flex-col gap-3 overflow-y-auto bg-bone px-5 py-5 text-sm">
          <p class="w-fit max-w-[90%] rounded-2xl rounded-bl-md bg-surface px-4 py-3 text-ink ring-1 ring-line">Hola, soy la recepción virtual de {clinic.name}. Puedo ayudarte a consultar horarios, tratamientos o dejar una solicitud de turno.</p>
        </div>
        <div class="chat-starters" aria-label="Consultas sugeridas">
          {starters.map((text) => <button type="button" data-chat-prompt={text}>{text}</button>)}
        </div>
        <form data-chat-form class="border-t border-line px-4 py-4">
          <label for="chat-input" class="mb-2 block text-xs font-medium text-muted">Tu consulta</label>
          <div class="flex items-center gap-2">
            <input id="chat-input" data-chat-input type="text" name="message" autocomplete="off" maxlength="2000" placeholder="Contanos cómo podemos ayudarte…" class="h-12 min-w-0 w-full rounded-xl border border-line bg-bone px-3 text-base text-ink outline-none placeholder:text-muted focus:border-accent disabled:opacity-60" />
            <button type="submit" data-chat-send class="h-12 shrink-0 rounded-xl bg-accent px-4 text-sm font-semibold text-white transition-colors hover:bg-accent-hover disabled:opacity-50">Enviar</button>
          </div>
        </form>
        <p data-chat-error role="alert" class="hidden px-5 pb-4 text-sm text-red-700"></p>
      </div>
      <p class="mt-3 text-center text-xs leading-relaxed text-muted">Tus datos se usan para coordinar tu atención. Para urgencias, contactá al equipo del consultorio.</p>
    </div>
  </div>
</section>

<script>
  const API_URL = '';
  const CLINIC_SLUG = document.querySelector<HTMLElement>('[data-clinic-slug]')?.dataset.clinicSlug ?? '';

  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = document.querySelector<HTMLInputElement>('[data-chat-input]');
  const messagesEl = document.querySelector<HTMLElement>('[data-chat-messages]');
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-chat-send]');
  const errorEl = document.querySelector<HTMLElement>('[data-chat-error]');

  const BUBBLE = 'w-fit max-w-[90%] whitespace-pre-wrap rounded-2xl px-4 py-2.5';
  const USER_BUBBLE = `${BUBBLE} ml-auto rounded-br-md bg-accent text-bone`;
  const BOT_BUBBLE = `${BUBBLE} rounded-bl-md bg-surface text-ink ring-1 ring-line`;

  const history: ChatMessage[] = [];
  const statusEl = document.querySelector<HTMLElement>('[data-chat-status]');
  const prompts = document.querySelectorAll<HTMLButtonElement>('[data-chat-prompt]');
  let sending = false;

  function setSending(value: boolean) {
    sending = value;
    if (sendBtn) sendBtn.disabled = value;
    if (input) input.disabled = value;
    prompts.forEach((button) => { button.disabled = value; });
    messagesEl?.setAttribute('aria-busy', String(value));
    if (statusEl) statusEl.textContent = value ? 'Preparando tu respuesta…' : 'Recepción virtual · Consultas y solicitudes';
  }

  function addBubble(role: 'user' | 'assistant', text: string): HTMLParagraphElement {
    const bubble = document.createElement('p');
    bubble.className = role === 'user' ? USER_BUBBLE : BOT_BUBBLE;
    bubble.textContent = text;
    messagesEl?.append(bubble);
    messagesEl?.scrollTo({ top: messagesEl.scrollHeight, behavior: 'smooth' });
    return bubble;
  }

  function renderAssistantText(element: HTMLElement, text: string) {
    const pattern = /\*\*[^*\n]+?\*\*|\*[^*\n]+?\*/g;
    const fragment = document.createDocumentFragment();
    let cursor = 0;

    for (const match of text.matchAll(pattern)) {
      const index = match.index ?? 0;
      if (index > cursor) fragment.append(document.createTextNode(text.slice(cursor, index)));
      const token = match[0];
      const bold = token.startsWith('**');
      const formatted = document.createElement(bold ? 'strong' : 'em');
      formatted.textContent = token.slice(bold ? 2 : 1, bold ? -2 : -1);
      fragment.append(formatted);
      cursor = index + token.length;
    }

    if (cursor < text.length) fragment.append(document.createTextNode(text.slice(cursor)));
    element.replaceChildren(fragment);
  }

  function showError(message: string | null) {
    if (!errorEl) return;
    errorEl.textContent = message ?? '';
    errorEl.classList.toggle('hidden', !message);
  }

  async function send(text: string) {
    if (!messagesEl || !sendBtn || sending) return;

    history.push({ role: 'user', content: text });
    const userBubble = addBubble('user', text);
    showError(null);

    if (input) input.value = '';
    setSending(true);

    const bubble = addBubble('assistant', 'escribiendo…');
    let answer = '';

    try {
      if (!CLINIC_SLUG) throw new Error('Chat no configurado');
      const url = new URL(`${API_URL}/api/secretaria/chat`);
      url.searchParams.set('clinic', CLINIC_SLUG);
      const res = await fetch(url, {
        method: 'POST',
        signal: AbortSignal.timeout(60_000),
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok || !res.body) {
        const detail = await res.json().catch(() => null);
        throw new Error(detail?.error ?? `El servidor respondió ${res.status}.`);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();

      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        answer += decoder.decode(value, { stream: true });
        renderAssistantText(bubble, answer);
        messagesEl.scrollTo({ top: messagesEl.scrollHeight });
      }

      answer += decoder.decode();
      if (!answer.trim()) throw new Error('Respuesta vacía');
      renderAssistantText(bubble, answer);

      history.push({ role: 'assistant', content: answer });
    } catch {
      bubble.remove();
      userBubble.remove();
      history.pop();
      if (input) input.value = text;
      showError('No pudimos responder en este momento. Tu consulta sigue escrita: podés volver a enviarla o contactar al consultorio.');
    } finally {
      setSending(false);
      input?.focus();
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input?.value.trim();
    if (text) void send(text);
  });

  prompts.forEach((button) => button.addEventListener('click', () => {
    const text = button.dataset.chatPrompt;
    if (text) void send(text);
  }));
  document.querySelectorAll('[data-chat-cta]').forEach((link) => link.addEventListener('click', () => {
    setTimeout(() => input?.focus({ preventScroll: true }), 300);
  }));
</script>
