<a
  id="cta-flotante"
  href="#reservar"
  class="fixed right-4 bottom-4 z-40 rounded-full bg-accent px-5 py-3 text-sm font-medium text-bone shadow-[0_16px_40px_-16px_rgba(23,73,62,0.7)] transition-opacity duration-300 hover:bg-accent-hover active:translate-y-px md:hidden"
>
  Reservar turno
</a>

<script is:inline>
  (function () {
    var pill = document.getElementById('cta-flotante');
    var target = document.getElementById('reservar');
    if (!pill || !target || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          pill.style.opacity = entry.isIntersecting ? '0' : '1';
          pill.style.pointerEvents = entry.isIntersecting ? 'none' : 'auto';
        });
      },
      { rootMargin: '0px 0px -40% 0px' }
    );
    io.observe(target);
  })();
</script>
