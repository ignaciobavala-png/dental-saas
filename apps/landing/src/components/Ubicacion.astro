---
const clinic = Astro.locals.clinic;

---
<section id="ubicacion" class="scroll-mt-20">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-2 lg:gap-16">
    <div class="reveal max-w-lg">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Cómo llegar
      </h2>
      <p class="mt-4 leading-relaxed text-muted">Encontrá la dirección y los horarios de atención.</p>

      <dl class="mt-8 space-y-5 text-sm">
        {clinic.address && <div>
          <dt class="font-medium text-ink">Dirección</dt>
          <dd class="text-muted">{clinic.address}</dd>
        </div>}
        {clinic.hours.length > 0 && <div>
          <dt class="font-medium text-ink">Horarios</dt>
          {clinic.hours.map((h) => (
            <dd class="text-muted">{h.day}: {h.time}</dd>
          ))}
        </div>}
        {(clinic.phone || clinic.email) && <div>
          <dt class="font-medium text-ink">Contacto</dt>
          <dd class="text-muted">
            {clinic.phone && <a href={clinic.phoneHref} class="hover:text-ink">{clinic.phone}</a>}{clinic.phone && clinic.email && ' · '}{clinic.email && <a href={`mailto:${clinic.email}`} class="hover:text-ink">{clinic.email}</a>}
          </dd>
        </div>}
      </dl>

      <a
        href={clinic.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink/30"
      >
        Ver en Google Maps <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="reveal grid min-h-72 place-items-center rounded-2xl border border-line bg-surface p-8 text-center md:min-h-[26rem]">
      <div>
        <p class="font-display text-2xl font-semibold text-ink">{clinic.name}</p>
        <p class="mt-2 text-muted">{clinic.address || 'Consultá la dirección al coordinar tu visita.'}</p>
        {clinic.mapsUrl && <a href={clinic.mapsUrl} target="_blank" rel="noopener" class="mt-6 inline-flex rounded-full bg-accent px-5 py-3 text-sm font-medium text-bone hover:bg-accent-hover">Abrir indicaciones</a>}
      </div>
    </div>
  </div>
</section>
